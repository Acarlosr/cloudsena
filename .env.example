# ============================================================
# CloudSena — copie para .env e ajuste
# ============================================================

# ---------- básico ----------
CLOUDSENA_ENVIRONMENT=local
CLOUDSENA_DEBUG=true
CLOUDSENA_HOST=0.0.0.0
CLOUDSENA_PORT=8000

# Onde ficam banco, thumbnails, transcrições e logs.
# Em produção no servidor Ubuntu: /srv/cloudsena/data
CLOUDSENA_DATA_DIR=./data

# SQLite por padrão. Para PostgreSQL:
# CLOUDSENA_DATABASE_URL=postgresql+psycopg://cloudsena:senha@localhost:5432/cloudsena
CLOUDSENA_DATABASE_URL=

# ---------- segurança ----------
# Criptografa as chaves de API guardadas no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se deixar vazio, uma chave é gerada em data/database/.secret.key (FAÇA BACKUP).
CLOUDSENA_SECRET_KEY=

# Exija um header X-CloudSena-Token nas chamadas da API.
# Deixe vazio para uso local sem autenticação.
CLOUDSENA_API_TOKEN=

CLOUDSENA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- transcrição (GPU) ----------
# RTX 3060 Ti 8 GB: large-v3 + float16 cabe e roda rápido.
# Se faltar VRAM, use medium ou distil-large-v3.
CLOUDSENA_WHISPER_MODEL=large-v3
CLOUDSENA_WHISPER_DEVICE=auto
CLOUDSENA_WHISPER_COMPUTE_TYPE=float16
CLOUDSENA_WHISPER_BEAM_SIZE=5
# Deixe vazio para detectar o idioma automaticamente
CLOUDSENA_TRANSCRIPTION_LANGUAGE=

# ---------- motores locais ----------
CLOUDSENA_OLLAMA_BASE_URL=http://localhost:11434
CLOUDSENA_OMP_BASE_URL=http://localhost:8080/v1

# ---------- embeddings ----------
# ollama | openai_compatible | none
CLOUDSENA_EMBEDDING_PROVIDER=ollama
CLOUDSENA_EMBEDDING_MODEL=nomic-embed-text
CLOUDSENA_EMBEDDING_DIM=768

# ---------- workers ----------
# 1 é o certo quando a GPU faz a transcrição (evita disputa de VRAM).
CLOUDSENA_WORKER_CONCURRENCY=1
CLOUDSENA_JOB_MAX_ATTEMPTS=3

# ---------- RAG ----------
CLOUDSENA_RETRIEVAL_TOP_K=40
CLOUDSENA_RERANK_TOP_K=8
CLOUDSENA_MAX_CONTEXT_CHARS=14000

# ---------- privacidade padrão de novas bibliotecas ----------
# local  = nada sai da máquina
# hybrid = vídeo e transcrição locais; só trechos vão para a API
# cloud  = processamento remoto autorizado
CLOUDSENA_DEFAULT_PRIVACY_MODE=hybrid

# ---------- frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
