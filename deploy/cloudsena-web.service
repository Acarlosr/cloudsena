# systemd — interface web (Next.js)
# Requer build prévio: cd /srv/cloudsena/frontend && npm run build

[Unit]
Description=CloudSena Web
After=network.target cloudsena.service

[Service]
Type=simple
User=acarlosr
WorkingDirectory=/srv/cloudsena/frontend
Environment="NODE_ENV=production"
# A API só escuta em 127.0.0.1; quem fala com ela é este processo.
Environment="NEXT_PUBLIC_API_URL=http://127.0.0.1:8000"
# Só escuta em 127.0.0.1 de propósito: quem fica exposto na rede é o nginx
# (ver deploy/nginx.conf), não o Next.js diretamente.
# Se der erro "npx: command not found" ao iniciar (comum quando o Node foi
# instalado via nvm, que não é visto pelo systemd), rode `which npx` no
# terminal e troque a linha abaixo pelo caminho completo que aparecer.
ExecStart=/usr/bin/npx next start -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
